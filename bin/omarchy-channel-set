#!/bin/bash

# omarchy:summary=Set the Omarchy git channel (Fedora packages always come from dnf/COPR).
# omarchy:args=<stable|rc|edge|dev>

if (($# == 0)); then
  echo "Usage: omarchy-channel-set [stable|rc|edge|dev]"
  exit 1
else
  channel="$1"
fi

case "$channel" in
"stable") omarchy-branch-set "master" ;;
"rc") omarchy-branch-set "rc" ;;
"edge") omarchy-branch-set "master" ;;
"dev") omarchy-branch-set "dev" ;;
*)
  echo "Unknown channel: $channel"
  exit 1
  ;;
esac

omarchy-update -y
