#!/bin/bash

# omarchy:summary=Get or set the default dictation backend
# omarchy:args=[backend]
# omarchy:examples=omarchy default dictation | omarchy default dictation voxtype

if (($# > 1)); then
  echo "Usage: omarchy default dictation [backend]" >&2
  exit 1
fi

if (($# == 0)); then
  config="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/defaults/dictation"
  if [[ ! -s $config ]]; then
    echo "No dictation backend configured. Select one in Setup > Defaults > Dictation." >&2
    exit 1
  fi
  read -r backend <"$config"
  [[ -n $backend ]] && echo "$backend"
  exit 0
fi

backend=$1

if [[ ! $backend =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
  echo "Invalid dictation backend: $backend" >&2
  exit 1
fi

# Voxtype is this port's only backend; its installer ships in the fork.
case $backend in
  voxtype) installer="omarchy-voxtype-install" ;;
  superwhisper | *) installer="omarchy-install-dictation-$backend" ;;
esac

if omarchy-cmd-missing "$installer"; then
  echo "No installer available for dictation backend: $backend" >&2
  exit 1
fi

if [[ $backend == "superwhisper" ]]; then
  omarchy-launch-floating-terminal-with-presentation "$installer"
  exit 0
fi

# Setting the default here, not inside the installer: the installer's gum
# prompt can be cancelled, so the choice only lands once it actually runs.
mkdir -p "${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/defaults"
echo "$backend" >"${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/defaults/dictation"
omarchy-launch-floating-terminal-with-presentation "$installer"
