#!/bin/bash

# omarchy:summary=Show or set the Omarchy language and the session's locale
# omarchy:args=[<code>|list|locale [<code>]|seed <code>]
# omarchy:examples=omarchy language | omarchy language da | omarchy language list

set -euo pipefail

locales_json=${OMARCHY_LOCALES_JSON:-$OMARCHY_PATH/default/i18n/locales.json}
language_file=${OMARCHY_LANGUAGE_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/language}

known_language() {
  jq -e --arg code "$1" 'has($code)' "$locales_json" >/dev/null 2>&1
}

current_language() {
  local code=""
  if [[ -f $language_file ]]; then
    code=$(head -n 1 "$language_file" | tr -d '[:space:]')
  fi

  if [[ -n $code ]] && known_language "$code"; then
    echo "$code"
  else
    echo "en"
  fi
}

locale_for() {
  jq -r --arg code "$1" '.[$code].locale // empty' "$locales_json"
}

name_for() {
  jq -r --arg code "$1" '.[$code].name // empty' "$locales_json"
}

list_languages() {
  # One tab-delimited row per language: native name, code, English name.
  # English first, the rest sorted by English name so the picker is findable
  # in any language.
  jq -r '
    to_entries
    | map({code: .key, name: .value.name, englishName: .value.englishName})
    | sort_by(if .code == "en" then "" else .englishName end)
    | .[]
    | [.name, .code, .englishName] | @tsv
  ' "$locales_json"
}

locale_generated() {
  # locale -a normalizes punctuation away (en_US.utf8), so compare squashed.
  local want available
  want=$(echo "$1" | tr -cd 'a-zA-Z0-9' | tr '[:upper:]' '[:lower:]')
  available=" $(locale -a 2>/dev/null | tr -cd 'a-zA-Z0-9\n' | tr '[:upper:]' '[:lower:]' | tr '\n' ' ') "
  [[ $available == *" $want "* ]]
}

# The session's LANG lives with the user, beside the language choice:
# uwsm sources this at login and exports it to every app it launches.
session_env=${XDG_CONFIG_HOME:-$HOME/.config}/uwsm/env.d/50-omarchy-language

# Generating a locale needs root (it installs a glibc langpack). Only the
# registry code is ever handed to it, never caller input.
generator=$OMARCHY_PATH/bin/omarchy-locale-generate
[[ -x /usr/bin/omarchy-locale-generate ]] && generator=/usr/bin/omarchy-locale-generate

generate_locale() {
  local code=$1 locale=$2
  locale_generated "$locale" && return

  if (( EUID == 0 )); then
    "$generator" "$code"
  elif [[ -t 0 ]]; then
    # A terminal can carry sudo's own prompt.
    sudo "$generator" "$code"
  else
    # Picked from the menu there is no terminal, so polkit asks on screen.
    pkexec "$generator" "$code"
  fi
}

# Sets LANG for the next login, and for the apps opened from now on. Apps
# already running keep the language they started with.
apply_session_locale() {
  local locale=$1
  mkdir -p "$(dirname "$session_env")"
  printf '# The session language, set by omarchy-language (Setup > Language).\nexport LANG=%s\n' "$locale" >"$session_env"
}

# A Chinese, Japanese or Korean language brings its input method and glyph
# forms, unless the user already has an input method or chose the forms.
seed_typing() {
  local method
  case $1 in
  ja) method=mozc ;;
  ko) method=hangul ;;
  zh-CN) method=pinyin ;;
  zh-TW) method=chewing ;;
  *) return 0 ;;
  esac
  /usr/bin/python3 "$OMARCHY_PATH/default/input-methods/typing_setup.py" seed-language "$method" || true
}

set_language() {
  local code=$1
  if ! known_language "$code"; then
    echo "Usage: omarchy-language [<code>|list|locale [<code>]]" >&2
    echo "Unknown language code: $code" >&2
    echo "Run 'omarchy-language list' to see the available codes." >&2
    exit 1
  fi

  local locale name
  locale=$(locale_for "$code")
  name=$(name_for "$code")

  generate_locale "$code" "$locale"

  # The choice is only persisted once the locale exists, so a cancelled
  # password prompt cannot leave the interface switched with LANG behind it.
  mkdir -p "$(dirname "$language_file")"
  echo "$code" >"$language_file"
  seed_typing "$code"
  apply_session_locale "$locale"

  omarchy-notification-send "$name" "Language set. Apps you open now and after the next login use it."
}

case "${1:-}" in
"")
  current_language
  ;;
list)
  list_languages
  ;;
seed)
  # Install finalization: the system step already generated the locale and
  # there is no session yet, so only files are written, and a language the
  # user already chose is kept: the preset is a default, never an override.
  code=${2:-}
  if ! known_language "$code"; then
    echo "Unknown language code: $code" >&2
    exit 1
  fi
  [[ -s $language_file ]] && exit 0
  mkdir -p "$(dirname "$session_env")" "$(dirname "$language_file")"
  printf '# The session language, set by omarchy-language (Setup > Language).\nexport LANG=%s\n' "$(locale_for "$code")" >"$session_env"
  echo "$code" >"$language_file"
  ;;
locale)
  code=${2:-$(current_language)}
  if ! known_language "$code"; then
    echo "Unknown language code: $code" >&2
    exit 1
  fi
  locale_for "$code"
  ;;
*)
  set_language "$1"
  ;;
esac
