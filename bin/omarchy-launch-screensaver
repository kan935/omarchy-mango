#!/bin/bash

# omarchy:summary=Launch the Omarchy screensaver in the default terminal on every monitor.

# Exit early if the screensaver is already running. The bracket trick keeps the
# launcher's own cmdline from matching — the class appears in argv, so a plain
# pattern would match anything that mentions it (including this script's caller).
pgrep -f '[o]rg.omarchy.screensaver' >/dev/null && exit 0

# Allow screensaver to be turned off but also force started
if omarchy-toggle-enabled screensaver-off && [[ $1 != "force" ]]; then
  exit 1
fi


focused=$(omarchy-mango-monitor-focused)
terminal=$(xdg-terminal-exec --print-id)

for m in $(mmsg get all-monitors | jq -r '.monitors[].name'); do
  mmsg dispatch "focusmon,$m" >/dev/null 2>&1

  case $terminal in
  *Alacritty*)
    command="alacritty --class=org.omarchy.screensaver --config-file $HOME/.local/share/omarchy/default/alacritty/screensaver.toml -e omarchy-screensaver"
    ;;
  *ghostty*)
    command="ghostty --class=org.omarchy.screensaver --config-file=$HOME/.local/share/omarchy/default/ghostty/screensaver --font-size=18 -e omarchy-screensaver"
    ;;
  *foot*)
    command="foot --app-id=org.omarchy.screensaver --config=$HOME/.local/share/omarchy/default/foot/screensaver.ini -e omarchy-screensaver"
    ;;
  *kitty*)
    command="kitty --class=org.omarchy.screensaver --override font_size=18 --override window_padding_width=0 -e omarchy-screensaver"
    ;;
  *)
    notify-send -u low "✋  Screensaver only runs in Alacritty, Foot, Ghostty, or Kitty"
    break
    ;;
  esac

  mmsg dispatch "spawn_shell,$command" >/dev/null 2>&1
  sleep 0.2
done

[[ -n $focused ]] && mmsg dispatch "focusmon,$focused" >/dev/null 2>&1
