#!/bin/bash

# omarchy:summary=Start Omarchy session services under Mango.
# omarchy:hidden=true

# Make the compositor environment available to systemd and D-Bus clients.
systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE MANGO_INSTANCE_SIGNATURE 2>/dev/null || true
dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE MANGO_INSTANCE_SIGNATURE 2>/dev/null || true

start_once() {
  local name=$1
  shift
  pgrep -x "$name" >/dev/null 2>&1 && return 0
  setsid "$@" >/dev/null 2>&1 &
}

stop_session_process() {
  local name=$1 pid runtime display

  for pid in $(pgrep -x "$name" 2>/dev/null); do
    runtime=$(tr '\0' '\n' <"/proc/$pid/environ" 2>/dev/null | sed -n 's/^XDG_RUNTIME_DIR=//p' | head -n 1)
    display=$(tr '\0' '\n' <"/proc/$pid/environ" 2>/dev/null | sed -n 's/^WAYLAND_DISPLAY=//p' | head -n 1)
    [[ $runtime == "${XDG_RUNTIME_DIR:-}" && $display == "${WAYLAND_DISPLAY:-}" ]] || continue
    kill "$pid" 2>/dev/null || true
  done
}

# Quattro owns the bar, wallpaper, notifications, OSD, polkit agent, and
# idle/lock handling. Stop the v3 daemons from this session so they do not
# fight it. Keep the match scoped to this Wayland runtime: a headless test
# or another login on the same user must not lose its desktop.
if [[ ${XDG_RUNTIME_DIR:-} == "/run/user/$(id -u)" ]]; then
  systemctl --user stop app-walker@autostart.service swayosd-server.service 2>/dev/null || true
fi
stop_session_process walker
stop_session_process waybar
stop_session_process mako
stop_session_process swaybg
stop_session_process swayidle
stop_session_process swayosd-server

if ! pgrep -f "$OMARCHY_PATH/shell" >/dev/null 2>&1; then
  setsid omarchy-launch-shell >/dev/null 2>&1 &
fi

# Input method
if command -v fcitx5 >/dev/null 2>&1; then
  start_once fcitx5 fcitx5 -d --disable notificationitem
fi

# Monitor hotplug helpers
pgrep -f 'omarchy-mango-monitor-watch' >/dev/null 2>&1 || setsid omarchy-mango-monitor-watch >/dev/null 2>&1 &

# Power profiles
command -v omarchy-powerprofiles-init >/dev/null 2>&1 && omarchy-powerprofiles-init >/dev/null 2>&1 || true

# One-time post-login setup, if the installer requested it
if [[ -f $HOME/.local/state/omarchy/first-run.mode ]]; then
  omarchy-first-run >/dev/null 2>&1 || true
fi
