#!/bin/bash

# omarchy:summary=Toggle a persistent Mango config flag (a snippet in default/mango/toggles).
# omarchy:args=[--enabled-notification <text>] [--disabled-notification <text>] <flag-name>

ENABLED_NOTIFICATION=""
DISABLED_NOTIFICATION=""

while [[ $# -gt 1 ]]; do
  case $1 in
    --enabled-notification) ENABLED_NOTIFICATION="$2"; shift 2 ;;
    --disabled-notification) DISABLED_NOTIFICATION="$2"; shift 2 ;;
    *) break ;;
  esac
done

FLAG_NAME="$1"
FLAG="$HOME/.local/state/omarchy/toggles/mango/$FLAG_NAME.conf"
FLAG_SOURCE="$OMARCHY_PATH/default/mango/toggles/$FLAG_NAME.conf"

if [[ -f $FLAG ]]; then
  rm -f "$FLAG"
  [[ -n $DISABLED_NOTIFICATION ]] && notify-send -u low "$DISABLED_NOTIFICATION"
elif [[ -f $FLAG_SOURCE ]]; then
  mkdir -p "$(dirname "$FLAG")"
  cp "$FLAG_SOURCE" "$FLAG"
  [[ -n $ENABLED_NOTIFICATION ]] && notify-send -u low "$ENABLED_NOTIFICATION"
else
  echo "Flag not found: $FLAG_NAME" >&2
  exit 1
fi

mmsg dispatch reload_config >/dev/null 2>&1 || true
