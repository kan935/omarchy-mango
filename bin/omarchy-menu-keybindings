#!/bin/bash

# omarchy:summary=Display Mango keybindings defined in your configuration using walker for an interactive search menu.

declare -A BINDINGS

parse_bindings_file() {
  local file="$1"
  [[ -f $file ]] || return

  while IFS= read -r line; do
    [[ $line =~ ^[[:space:]]*# ]] && continue
    [[ $line =~ ^[[:space:]]*(bind|bindl|bindr|bindc)=(.*)$ ]] || continue

    local rest="${BASH_REMATCH[2]}"
    local mods="${rest%%,*}"
    rest="${rest#*,}"
    local key="${rest%%,*}"
    rest="${rest#*,}"
    local dispatcher="${rest%%,*}"
    local arg="${rest#*,}"
    [[ $arg == "$rest" ]] && arg=""

    local combo
    if [[ -z $mods || $mods == "NONE" ]]; then
      combo="$key"
    else
      combo="${mods//+/ + } + $key"
    fi

    BINDINGS["$combo"]=$(describe "$dispatcher" "$arg")
  done <"$file"
}

describe() {
  local dispatcher="$1" arg="$2"
  local action

  case "$dispatcher" in
  spawn | spawn_shell)
    action="$arg"
    action="${action//\~\/.local\/share\/omarchy\/bin\//}"
    action="${action#uwsm-app -- }"
    action="${action#uwsm app -- }"
    ;;
  view) action="Switch to workspace $arg" ;;
  tag) action="Move window to workspace $arg" ;;
  tagsilent) action="Move window silently to workspace $arg" ;;
  toggleview) action="Toggle workspace $arg visibility" ;;
  viewtoleft) action="Previous workspace" ;;
  viewtoright) action="Next workspace" ;;
  viewtoleft_have_client) action="Previous workspace with a window" ;;
  viewtoright_have_client) action="Next workspace with a window" ;;
  focusdir) action="Focus window $arg" ;;
  move_client) action="Move window $arg" ;;
  exchange_client) action="Swap window $arg" ;;
  focusmon) action="Focus monitor $arg" ;;
  focusstack) action="Cycle windows ($arg)" ;;
  focuslast) action="Focus last window" ;;
  focus_window_or_workspace) action="Focus window or workspace $arg" ;;
  groupjoin) action="Join group $arg" ;;
  groupleave) action="Leave group" ;;
  groupfocus) action="Focus group member $arg" ;;
  togglegroupbar) action="Toggle group bar" ;;
  killclient) action="Close window" ;;
  smartkillclient) action="Close window (detach from tag first)" ;;
  togglefloating) action="Toggle window floating" ;;
  togglefullscreen) action="Toggle full screen" ;;
  togglefakefullscreen) action="Toggle fake full screen" ;;
  togglemaximizescreen) action="Toggle maximized" ;;
  toggleglobal) action="Pin window to all workspaces" ;;
  toggleoverview) action="Toggle overview" ;;
  enteroverview) action="Enter overview" ;;
  leaveoverview) action="Leave overview" ;;
  togglejump) action="Toggle overview jump mode" ;;
  toggle_special_tag) action="Toggle scratchpad" ;;
  tag_special_tag) action="Move window to scratchpad" ;;
  tag_special_silent) action="Silently move window to scratchpad" ;;
  toggle_scratchpad) action="Toggle scratchpad" ;;
  minimize | minimized) action="Minimize window" ;;
  restore_minimized) action="Restore minimized window" ;;
  reload_config) action="Reload Mango configuration" ;;
  quit) action="Quit Mango" ;;
  resizewin) action="Resize window $arg" ;;
  movewin) action="Move window $arg" ;;
  moveresize) action="Drag to $arg" ;;
  setlayout) action="Set layout $arg" ;;
  switch_layout) action="Cycle layout" ;;
  incgaps) action="Adjust gaps $arg" ;;
  togglegaps) action="Toggle gaps" ;;
  dwindle_toggle_split_direction) action="Toggle split direction" ;;
  dwindle_toggle_current_split) action="Toggle current split direction" ;;
  switch_keyboard_layout) action="Switch keyboard layout${arg:+ $arg}" ;;
  switch_proportion_preset) action="Cycle scroller proportion" ;;
  set_proportion) action="Set scroller proportion $arg" ;;
  scroller_stack) action="Move window in scroller stack $arg" ;;
  incnmaster) action="Adjust master count $arg" ;;
  setmfact) action="Adjust master size $arg" ;;
  zoom) action="Swap window with master" ;;
  centerwin) action="Center floating window" ;;
  smartmovewin) action="Move floating window $arg" ;;
  smartresizewin) action="Resize floating window $arg" ;;
  create_virtual_output) action="Create virtual output" ;;
  destroy_all_virtual_output) action="Destroy virtual outputs" ;;
  sleep_monitor) action="Sleep monitor $arg" ;;
  wakeup_monitor) action="Wake monitor $arg" ;;
  *)
    action="$dispatcher${arg:+ $arg}"
    ;;
  esac

  printf '%s' "$action"
}

output_keybindings() {
  BINDINGS=()
  parse_bindings_file "$OMARCHY_PATH/default/mango/bindings.conf"
  parse_bindings_file "$HOME/.config/mango/bindings.conf"

  for combo in "${!BINDINGS[@]}"; do
    [[ -z ${BINDINGS[$combo]} ]] && continue
    printf '%-35s → %s\n' "$combo" "${BINDINGS[$combo]}"
  done | prioritize_entries
}

prioritize_entries() {
  awk '
  {
    line = $0
    prio = 50
    if (match(line, /Terminal/)) prio = 0
    if (match(line, /Tmux/)) prio = 1
    if (match(line, /Browser/) && !match(line, /Browser[[:space:]]*\(/)) prio = 2
    if (match(line, /File manager/) && !match(line, /File manager \(cwd\)/)) prio = 3
    if (match(line, /Launch apps/)) prio = 4
    if (match(line, /Omarchy menu/)) prio = 5
    if (match(line, /System menu/)) prio = 6
    if (match(line, /Theme menu/)) prio = 7
    if (match(line, /Full screen/)) prio = 8
    if (match(line, /Full width/)) prio = 9
    if (match(line, /Close window/)) prio = 10
    if (match(line, /Close all windows/)) prio = 11
    if (match(line, /Lock system/)) prio = 12
    if (match(line, /Toggle window floating/)) prio = 13
    if (match(line, /Toggle split/)) prio = 14
    if (match(line, /Pop window/)) prio = 15
    if (match(line, /Clipboard/)) prio = 17
    if (match(line, /Audio controls/)) prio = 18
    if (match(line, /Bluetooth controls/)) prio = 19
    if (match(line, /Wifi controls/)) prio = 20
    if (match(line, /Color picker/)) prio = 22
    if (match(line, /Screenshot/)) prio = 23
    if (match(line, /Screenrecording/)) prio = 24
    if (match(line, /Switch to workspace/)) prio = 27
    if (match(line, /Move window to workspace/)) prio = 28
    if (match(line, /Move window silently/)) prio = 29
    if (match(line, /Swap window/)) prio = 30
    if (match(line, /Focus window/)) prio = 31
    if (match(line, /Focus monitor/)) prio = 32
    if (match(line, /Resize window/)) prio = 33
    if (match(line, /scratchpad/)) prio = 36
    if (match(line, /notification/)) prio = 37
    if (match(line, /Toggle window transparency/)) prio = 38
    if (match(line, /Toggle workspace gaps/)) prio = 39
    if (match(line, /nightlight/)) prio = 40
    if (match(line, /Toggle locking/)) prio = 41
    if (match(line, /group/)) prio = 94
    if (match(line, /Cycle/)) prio = 96
    if (match(line, /XF86/)) prio = 99

    printf "%d\t%s\n", prio, line
  }' |
    sort -k1,1n -k2,2 |
    cut -f2-
}

if [[ $1 == "--print" || $1 == "-p" ]]; then
  output_keybindings
else
  monitor_height=$(mmsg get all-monitors | jq -r '[.monitors[] | select(.active == true) | .height] | first // 800')
  menu_height=$((monitor_height * 40 / 100))

  output_keybindings |
    walker --dmenu -p 'Keybindings' --width 800 --height "$menu_height"
fi
