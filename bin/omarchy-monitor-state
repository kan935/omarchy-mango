#!/bin/bash

# omarchy:summary=Print monitor panel state for the shell (MangoWC)
# omarchy:group=monitor

set -euo pipefail

monitors_json=$(mmsg get all-monitors)
focused_monitor=$(mmsg get cursorpos 2>/dev/null | jq -r '.monitor // ""')

# Fall back to the first active monitor when the pointer has no monitor.
if [[ -z $focused_monitor ]]; then
  focused_monitor=$(jq -r '[.monitors[] | select(.active == true)][0].name // ""' <<<"$monitors_json")
fi

# Brightness is only meaningful for a laptop's internal panel. External
# DDC/CI displays have no generic Wayland brightness interface here.
if [[ $focused_monitor =~ ^(eDP|LVDS|DSI)- ]] && command -v brightnessctl >/dev/null 2>&1; then
  device="$(omarchy-hw-display 2>/dev/null || true)"
  if [[ -n $device ]]; then
    brightnessctl -d "$device" -m 2>/dev/null | awk -F, '{ gsub("%", "", $4); print $4; found=1 } END { exit !found }' || echo unavailable
  else
    echo unavailable
  fi
else
  echo unavailable
fi

jq -r '
  def internal: test("^(eDP|LVDS|DSI)-");
  ([.monitors[] | select(.name | internal)][0].name // ""),
  ([.monitors[] | select((.name | internal) | not)][0].name // ""),
  ([.monitors[] | select((.name | internal) and .active == true)][0].name // ""),
  "" # Mango has no mirror-of metadata; mirroring is explicit output layout.
' <<<"$monitors_json"

printf '%s\n' "$focused_monitor"

jq -r --arg focused "$focused_monitor" '
  [.monitors[] | select(.name == $focused)][0].scale // "" | tostring
' <<<"$monitors_json"

jq -c --arg focused "$focused_monitor" '
  [.monitors[] | {
    name: .name,
    enabled: (.active == true),
    focused: (.name == $focused),
    width: (if .active then ((.width * .scale) | round) else 0 end),
    height: (if .active then ((.height * .scale) | round) else 0 end)
  }]
' <<<"$monitors_json"
