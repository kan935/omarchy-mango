#!/bin/bash

# omarchy:summary=Toggle passwordless sudo for the current user.
# omarchy:args=[15|60|permanent]
# omarchy:requires-sudo=true

NOPASSWD_FILE="/etc/sudoers.d/99-omarchy-nopasswd-${USER}"
TIMER_NAME="omarchy-nopasswd-expire-${USER}"
STATE_DIR="$HOME/.local/state/omarchy/indicators"
STATE_FILE="$STATE_DIR/passwordless-sudo"
OMARCHY_PATH="${OMARCHY_PATH:-$HOME/.local/share/omarchy}"
OMARCHY_BIN="$OMARCHY_PATH/bin"

mark_state() {
  mkdir -p "$STATE_DIR"
  printf '%s\n' "$1" >"$STATE_FILE"
}

clear_state() {
  rm -f "$STATE_FILE"
}

refresh_indicator() {
  "$OMARCHY_BIN/omarchy-shell" -q omarchy.indicators refresh 2>/dev/null || true
}

# Status probe for the bar indicator: silent, never prompts.
if [[ ${1:-} == "--active" ]]; then
  sudo -n test -f "$NOPASSWD_FILE" 2>/dev/null && exit 0 || exit 1
fi

# One-click disable from the bar indicator.
if [[ ${1:-} == "--disable" ]]; then
  sudo rm -f "$NOPASSWD_FILE" 2>/dev/null || true
  sudo systemctl stop "${TIMER_NAME}.timer" 2>/dev/null || true
  clear_state
  refresh_indicator
  exit 0
fi

# Echo the duration in minutes, or "permanent", for the given spec.
parse_duration() {
  local spec=$1
  case "$spec" in
    permanent | --permanent | forever | always)
      echo permanent
      return 0
      ;;
  esac
  if [[ $spec =~ ^([0-9]+)h([0-9]+)m?$ ]]; then
    echo $((BASH_REMATCH[1] * 60 + BASH_REMATCH[2]))
    return 0
  fi
  if [[ $spec =~ ^([0-9]+)h$ ]]; then
    echo $((BASH_REMATCH[1] * 60))
    return 0
  fi
  if [[ $spec =~ ^[0-9]+$ ]]; then
    echo "$spec"
    return 0
  fi
  return 1
}

# Interactive duration picker used when no argument is given.
choose_duration() {
  local choice
  choice=$(gum choose "15 minutes" "1 hour" "Until I disable it" \
    --header "Enable passwordless sudo for how long?" 2>/dev/null) || return 1
  case $choice in
    "15 minutes") echo 15 ;;
    "1 hour") echo 60 ;;
    "Until I disable it") echo permanent ;;
    *) return 1 ;;
  esac
}

DURATION=""
if [[ $# -ge 1 ]]; then
  DURATION=$(parse_duration "$1") || {
    echo "Usage: omarchy-sudo-passwordless [15|60|permanent]" >&2
    exit 1
  }
else
  DURATION=$(choose_duration) || {
    echo "Aborted. No changes made."
    exit 130
  }
fi

if [[ $DURATION == "permanent" ]]; then
  duration_text="until you disable it (it survives restarts)"
else
  duration_text="for ${DURATION} minutes"
fi

echo "Toggle passwordless sudo..."

# Safety: if a timed grant's file outlived its timer (e.g. after reboot),
# clean it up. A permanent grant has no timer and is spared.
if sudo -n test -f "$NOPASSWD_FILE" 2>/dev/null && ! systemctl is-active "${TIMER_NAME}.timer" &>/dev/null; then
  if [[ $(cat "$STATE_FILE" 2>/dev/null) != "permanent" ]]; then
    sudo rm -f "$NOPASSWD_FILE"
    clear_state
    refresh_indicator
  fi
fi

# The timer runs as root, so it drops the state file itself and wakes the bar
# indicator as the user: the shell's socket lives in the user's runtime
# directory, and omarchy-shell recovers the display from it.
run_expiry_timer() {
  local minutes=$1
  sudo systemd-run --on-active=${minutes}m --timer-property=AccuracySec=1s --unit="$TIMER_NAME" \
    bash -c 'rm -f "$1" "$2"; runuser -u "$3" -- env OMARCHY_PATH="$4" XDG_RUNTIME_DIR="/run/user/$5" "$6" -q omarchy.indicators refresh' \
    omarchy-nopasswd-expire "$NOPASSWD_FILE" "$STATE_FILE" "$USER" \
    "$OMARCHY_PATH" "$(id -u)" "$OMARCHY_BIN/omarchy-shell"
}

# Check for the file directly — sudo -n can stay cached or be granted by other rules
if sudo -n test -f "$NOPASSWD_FILE" 2>/dev/null; then
  sudo systemctl stop "${TIMER_NAME}.timer" 2>/dev/null || true
  if [[ $DURATION == "permanent" ]]; then
    mark_state permanent
    echo "Passwordless sudo will now stay on until you disable it."
  else
    run_expiry_timer "$DURATION"
    mark_state ""
    echo "Passwordless sudo timer updated. It will now automatically disable in ${DURATION} minutes."
  fi
  refresh_indicator
  exit 0
fi

echo ""
echo "⚠️ WARNING: This will allow ANY process running as your user to"
echo "execute ANY command as root WITHOUT a password ${duration_text}."
echo ""
echo "This is useful for AI agents that need to run sudo commands,"
echo "but it significantly weakens the security of your system."
echo "Anyone or anything with access to your user account gets full root."
echo ""

if [[ $DURATION != "permanent" ]]; then
  echo "Passwordless sudo will automatically disable after ${DURATION} minutes."
  echo "Run this command again to disable it early or change the duration."
else
  echo "Run this command again (or click the bar indicator) to disable it."
fi
echo ""

if gum confirm "Enable passwordless sudo ${duration_text}? This is a significant security risk!"; then
  echo "${USER} ALL=(ALL) NOPASSWD: ALL" | sudo tee "$NOPASSWD_FILE" > /dev/null
  sudo chmod 440 "$NOPASSWD_FILE"
  if [[ $DURATION == "permanent" ]]; then
    sudo systemctl stop "${TIMER_NAME}.timer" 2>/dev/null || true
    mark_state permanent
    echo ""
    echo "Passwordless sudo has been ENABLED until you disable it."
    echo "Run omarchy-sudo-passwordless again (or click the bar indicator) to disable it."
  else
    run_expiry_timer "$DURATION"
    mark_state ""
    echo ""
    echo "Passwordless sudo has been ENABLED. It will automatically disable in ${DURATION} minutes."
    echo "Note: if you restart before then, run omarchy-sudo-passwordless again to disable it."
  fi
  refresh_indicator
else
  echo "Aborted. No changes made."
fi
