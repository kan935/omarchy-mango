#!/bin/bash

# omarchy:summary=Lock the computer and turn off the display
# omarchy:group=system
# omarchy:name=lock
# omarchy:examples=omarchy system lock

locked_with_shell=false
lock_result=$(omarchy-shell lock lock 2>/dev/null || true)
if [[ $lock_result == "ok" ]]; then
  locked_with_shell=true
elif ! pgrep -x swaylock >/dev/null; then
  (
    config="$HOME/.config/omarchy/current/theme/swaylock.conf"
    if [[ -f $config ]]; then
      swaylock -C "$config"
    else
      swaylock -c 000000
    fi
    omarchy-system-wake
  ) &
fi

# Set keyboard layout to default (first layout)
mmsg dispatch "switch_keyboard_layout,0" >/dev/null 2>&1 || true

# Ensure 1password is locked
if pgrep -x "1password" >/dev/null; then
  1password --lock &
fi

# Avoid running screensaver when locked
pkill -f org.omarchy.screensaver

if [[ ${OMARCHY_LOCK_ONLY:-false} != "true" ]]; then
  (
    sleep 3
    if $locked_with_shell; then
      [[ $(omarchy-shell lock isLocked 2>/dev/null) == "true" ]] || exit 0
    else
      pgrep -x swaylock >/dev/null || exit 0
    fi
    omarchy-brightness-keyboard off
    omarchy-brightness-display off
  ) &
fi
