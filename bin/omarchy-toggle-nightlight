#!/bin/bash

# omarchy:summary=Toggle nightlight screen temperature with gammastep
# omarchy:examples=omarchy toggle nightlight

ON_TEMP=4000
OFF_TEMP=6500
STATE_FILE="$HOME/.local/state/omarchy/toggles/mango/nightlight-on"

restart_nightlighted_waybar() {
  if grep -q "custom/nightlight" ~/.config/waybar/config.jsonc 2>/dev/null; then
    omarchy-restart-waybar
  fi
}

if [[ -f $STATE_FILE ]]; then
  gammastep -O "$OFF_TEMP" >/dev/null 2>&1 || true
  rm -f "$STATE_FILE"
  notify-send -u low "   Daylight screen temperature"
else
  if ! command -v gammastep >/dev/null 2>&1; then
    notify-send -u low "Nightlight unavailable" "Install gammastep to use nightlight" -t 3000
    exit 1
  fi
  gammastep -O "$ON_TEMP" >/dev/null 2>&1 || true
  mkdir -p "$(dirname "$STATE_FILE")"
  touch "$STATE_FILE"
  notify-send -u low "  Nightlight screen temperature"
fi

restart_nightlighted_waybar
