#!/bin/bash

# omarchy:summary=Enable, disable, or toggle the touchpad
# omarchy:args=[on|off|toggle]

STATE_CONF="$HOME/.local/state/omarchy/toggles/mango/touchpad-disabled.conf"

device="$(omarchy-hw-touchpad)"

if [[ -z $device ]]; then
  echo "No touchpad device found" >&2
  exit 1
fi

reload() {
  mmsg dispatch reload_config >/dev/null 2>&1 || true
}

enable() {
  rm -f "$STATE_CONF"
  reload
  omarchy-osd -i touchpad -m "Touchpad enabled"
}

disable() {
  mkdir -p "$(dirname "$STATE_CONF")"
  printf 'device_rule=name:%s,send_events_mode:1\n' "$device" >"$STATE_CONF"
  reload
  omarchy-osd -i touchpad -m "Touchpad disabled"
}

case "${1:-toggle}" in
on) enable ;;
off) disable ;;
toggle) if [[ -f $STATE_CONF ]]; then enable; else disable; fi ;;
esac
