#!/bin/bash

# omarchy:summary=Toggle the Omarchy bar (Quattro when running, Waybar fallback)
# omarchy:examples=omarchy toggle waybar

# Quattro's shell owns the bar in the primary session. Use its flag and IPC so
# the legacy Waybar process is never started alongside it.
if omarchy-shell shell ping >/dev/null 2>&1; then
  exec omarchy-toggle-bar "${1:-toggle}"
fi

omarchy-toggle waybar-off

if pgrep -x waybar >/dev/null; then
  pkill -9 -x waybar
else
  uwsm-app -- waybar >/dev/null 2>&1 &
fi
