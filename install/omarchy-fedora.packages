# Fedora packages installed by install-fedora.sh
#
# MangoWC is packaged as `mangowm` in the Terra repository:
#   https://terra.fyralabs.com/
# The installer reports a clear error if `mango` is still missing afterwards.
#
# Optional apps that Fedora does not package (Spotify, Obsidian, Typora,
# LocalSend) are intentionally not listed. Install them from Flathub or their
# vendor repositories. Craft apps and Nuvio are installed from their latest
# GitHub releases by install-fedora.sh.

# Compositor and desktop shell
mangowm
quickshell
swaylock
gammastep

# Session integration
socat
dbus-tools
polkit
xdg-utils
xdg-user-dirs
xdg-desktop-portal
xdg-desktop-portal-wlr
xdg-desktop-portal-gtk
gnome-keyring
libsecret
libnotify
xorg-x11-server-Xwayland
qt5-qtwayland
qt6-qtwayland
qt6-qtimageformats
qt5ct
qt6ct
libxkbcommon-utils
# Ly login manager; install-fedora.sh installs its config and enables it on tty1.
ly

# Input, audio, and hardware controls
brightnessctl
playerctl
pamixer
wireplumber
pipewire
pipewire-pulseaudio
pipewire-utils
alsa-utils
upower
power-profiles-daemon
wtype
ydotool
wlr-randr

# Clipboard, capture, and recording
wl-clipboard
cliphist
grim
slurp
satty
wf-recorder
tesseract
tesseract-langpack-eng
zbar
qrencode
ImageMagick
# RPM Fusion's full ffmpeg package; install-fedora.sh swaps it in for
# ffmpeg-free when Fedora preinstalled the free variant.
ffmpeg
# Poster frames for motion wallpapers in the background picker and lock screen.
ffmpegthumbnailer

# Terminals and everyday applications
foot
helium-bin
nemo
telegram-desktop
harbor-beta
gnome-calculator
gnome-disk-utility
file-roller
imv
mpv
network-manager-applet
nm-connection-editor
NetworkManager-tui
blueman
pavucontrol
pulseaudio-utils
wiremix
v4l-utils

# Input method
fcitx5
fcitx5-gtk
fcitx5-qt
fcitx5-mozc

# CLI tools used by Omarchy
git
neovim
curl
gh
distrobox
podman
flatpak
jq
yq
fzf
ripgrep
fd-find
bat
eza
zoxide
starship
tmux
btop
fastfetch
gum
inxi
unzip
less
man-db
procps-ng
psmisc
util-linux

# Fonts and icons
fontawesome-fonts-all
jetbrains-mono-fonts-all
